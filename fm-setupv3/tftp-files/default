#/srv/tftp/pxelinux.cfg/default

DEFAULT install
PROMPT 0
TIMEOUT 50

LABEL install
    MENU LABEL Automatische Installation (Preseed)
    KERNEL debian-installer/amd64/linux
    APPEND initrd=debian-installer/amd64/initrd.gz auto=true priority=critical \
    preseed/url=http://192.168.50.45/pxe/preseed.cfg \
    netcfg/choose_interface=auto netcfg/disable_dhcp=false \
    DEBIAN_FRONTEND=noninteractive fb=false vga=normal
